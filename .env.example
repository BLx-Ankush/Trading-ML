# Broker API Credentials
BROKER_NAME=zerodha  # Options: zerodha, upstox, angel_one, icici
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
ACCESS_TOKEN=your_access_token_here

# Trading Configuration
TRADING_CAPITAL=200000  # Initial capital in INR
MAX_POSITION_SIZE=0.1   # Max 10% of capital per position
DAILY_LOSS_LIMIT=0.05   # 5% daily loss limit
WEEKLY_LOSS_LIMIT=0.10  # 10% weekly loss limit
MONTHLY_LOSS_LIMIT=0.15 # 15% monthly loss limit

# Risk Parameters
RISK_PER_TRADE=0.01     # 1% of capital per trade
MIN_RISK_REWARD=1.5     # Minimum 1.5:1 R:R
MAX_OPEN_POSITIONS=3    # Maximum concurrent positions
CONSECUTIVE_LOSS_LIMIT=5 # Pause after 5 losses in a row

# Model Configuration
LIGHTGBM_THRESHOLD=0.65  # Minimum confidence to trade
HMM_RETRAIN_DAYS=30      # Retrain HMM every 30 days
LOOKBACK_PERIOD=252      # Trading days for training data

# Execution Settings
ORDER_TYPE=LIMIT         # LIMIT or MARKET
SLIPPAGE_TOLERANCE=0.002 # 0.2% slippage tolerance
ORDER_TIMEOUT=300        # 5 minutes order timeout

# Backtesting
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2025-12-31
BACKTEST_SLIPPAGE=0.001  # 0.1% slippage
BACKTEST_COMMISSION=0.0003 # 0.03% commission
BACKTEST_STT_TAX=0.00025  # 0.025% STT

# Database (Optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_TO_FILE=True
LOG_DIRECTORY=logs

# Notifications (Optional)
ENABLE_ALERTS=True
ALERT_EMAIL=your_email@example.com
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
ALERT_PHONE_NUMBER=+1234567890

# System Mode
TRADING_MODE=paper  # paper, backtest, live
